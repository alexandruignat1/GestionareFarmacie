<Window x:Class="GestionareFarmacie.WPF.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autentificare - Farmacie" Height="450" Width="400" 
        WindowStartupLocation="CenterScreen" Background="#F3F4F6" ResizeMode="NoResize"
        >

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#0078D7"/>
        <SolidColorBrush x:Key="TextDark" Color="#202124"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,15,0,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border Background="White" Margin="30" Padding="25" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="Gray" BlurRadius="15" Opacity="0.2" ShadowDepth="2"/>
        </Border.Effect>

        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Conectare personal" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <Label Content="E-mail:" Foreground="{StaticResource TextDark}" FontWeight="SemiBold" Padding="0" Margin="0,0,0,5"/>
            <TextBox x:Name="txtEmail" Height="30" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,15"/>

            <Label Content="Parolă:" Foreground="{StaticResource TextDark}" FontWeight="SemiBold" Padding="0" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtParola" Height="30" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,0,20"/>

            <Button x:Name="btnConectare" Content="Conectează-te" Click="btnConectare_Click"/>

            <Button x:Name="btnRecuperareParola" Content="Ați uitat parola?" Click="btnRecuperareParola_Click" Background="Transparent" Foreground="#0078D7" FontWeight="Normal" Margin="0,5,0,0" Height="25"/>

            <Button x:Name="btnCreareCont" Content="Doriți să creați un cont nou?" Click="btnCreareCont_Click" Background="Transparent" Foreground="#5C6B73" FontWeight="Normal" Margin="0" Height="25"/>
        </StackPanel>
    </Border>
</Window>