<Window x:Class="GestionareFarmacie.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistem gestiune farmacie" Height="600" Width="1050" MinWidth="950" MinHeight="550" Background="#F3F4F6">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#0078D7"/>
        <SolidColorBrush x:Key="TextDark" Color="#202124"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBlue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,12,0,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <TabControl Margin="10">
        <TabItem Header="Gestiune medicamente" FontSize="14" FontWeight="SemiBold">
            <Grid Margin="15,15,15,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" Margin="0,0,20,0" VerticalScrollBarVisibility="Auto" Padding="5">
                    <StackPanel>
                        <TextBlock Text="Detalii medicament" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,10" HorizontalAlignment="Center"/>

                        <Label Content="Nume medicament:"/>
                        <TextBox x:Name="txtNume" Text="{Binding MedicamentCurent.Nume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

                        <Label Content="Tip medicament:"/>
                        <ComboBox x:Name="cmbTip" Height="26" SelectedItem="{Binding MedicamentCurent.Tip, Mode=TwoWay}" VerticalContentAlignment="Center" Padding="4,0"/>

                        <Label Content="Moment administrare:"/>
                        <WrapPanel VerticalAlignment="Center" Margin="0,2,0,0">
                            <CheckBox x:Name="cbDimineata" Content="Dimineața" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <CheckBox x:Name="cbPranz" Content="Prânz" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <CheckBox x:Name="cbSeara" Content="Seara" Margin="0,0,0,0" VerticalAlignment="Center"/>
                        </WrapPanel>

                        <Label Content="Data expirării:"/>
                        <DatePicker x:Name="dpDataExpirarii" SelectedDate="{Binding MedicamentCurent.DataExpirarii, Mode=TwoWay, ValidatesOnDataErrors=True}"/>

                        <Label Content="Preț (RON):"/>
                        <TextBox x:Name="txtPret" Text="{Binding MedicamentCurent.Pret, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

                        <Label Content="Stoc disponibil:"/>
                        <TextBox x:Name="txtStoc" Margin="0,0,0,20" Text="{Binding MedicamentCurent.Stoc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

                        <UniformGrid Columns="2" HorizontalAlignment="Center" Width="260">
                            <Button x:Name="btnAdauga" Content="Adaugă" Click="btnAdauga_Click"/>
                            <Button x:Name="btnModifica" Content="Modifică" Click="btnModifica_Click"/>
                            <Button x:Name="btnSterge" Content="Șterge" Click="btnSterge_Click" Background="#5C6B73"/>
                            <Button x:Name="btnReset" Content="Reset" Click="btnReset_Click" Background="#5C6B73"/>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15" VerticalAlignment="Center">
                        <Label Content="Filtrare după nume:" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtCautare" Width="180" Height="28" VerticalAlignment="Center"/>
                        <Button x:Name="btnCauta" Content="Caută" Click="btnCauta_Click" Width="80" Height="28" Margin="15,0,5,0" VerticalAlignment="Center"/>
                        <Button x:Name="btnToate" Content="Toate" Click="btnToate_Click" Width="80" Height="28" Background="#5C6B73" Margin="5,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <DataGrid x:Name="dgMedicamente" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                              AlternatingRowBackground="#EAF3FA" HeadersVisibility="Column"
                              ItemsSource="{Binding ListaMedicamente}" SelectedItem="{Binding MedicamentCurent}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/>
                            <DataGridTextColumn Header="Nume" Binding="{Binding Nume}" Width="*"/>
                            <DataGridTextColumn Header="Tip" Binding="{Binding Tip}" Width="85"/>
                            <DataGridTextColumn Header="Expiră la" Binding="{Binding DataExpirarii, StringFormat=dd.MM.yyyy}" Width="85"/>
                            <DataGridTextColumn Header="Preț" Binding="{Binding Pret}" Width="65"/>
                            <DataGridTextColumn Header="Stoc" Binding="{Binding Stoc}" Width="55"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </TabItem>

        <TabItem x:Name="tabPersonal" Header="Personal farmacie" FontSize="14" FontWeight="SemiBold">
            <Grid Margin="15,15,15,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" Margin="0,0,20,0" VerticalScrollBarVisibility="Auto" Padding="5">
                    <StackPanel>
                        <TextBlock Text="Detalii farmacist" FontSize="18" FontWeight="Bold" Foreground="#27AE60" Margin="0,0,0,10" HorizontalAlignment="Center"/>

                        <Label Content="Nume și prenume:"/>
                        <TextBox x:Name="txtNumeFarmacist" Text="{Binding FarmacistCurent.Nume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

                        <Label Content="E-mail cont:"/>
                        <TextBox x:Name="txtEmailFarmacist" Text="{Binding FarmacistCurent.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

                        <Label Content="Parolă cont:"/>
                        <TextBox x:Name="txtParolaFarmacist" Margin="0,0,0,10" Text="{Binding FarmacistCurent.Parola, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

                        <CheckBox x:Name="cbEsteAdmin" Content="Are drepturi de Administrator" IsChecked="{Binding FarmacistCurent.EsteAdmin, Mode=TwoWay}" Margin="0,0,0,20" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#202124"/>

                        <UniformGrid Columns="2" HorizontalAlignment="Center" Width="260">
                            <Button x:Name="btnAdaugaFarmacist" Content="Adaugă" Click="btnAdaugaFarmacist_Click" Background="#27AE60"/>
                            <Button x:Name="btnModificaFarmacist" Content="Modifică" Click="btnModificaFarmacist_Click" Background="#F39C12"/>
                            <Button x:Name="btnStergeFarmacist" Content="Șterge" Click="btnStergeFarmacist_Click" Background="#5C6B73"/>
                            <Button x:Name="btnResetFarmacist" Content="Reset" Click="btnResetFarmacist_Click" Background="#5C6B73"/>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Column="1">
                    <DataGrid x:Name="dgFarmacisti" AutoGenerateColumns="False" IsReadOnly="True" 
                              AlternatingRowBackground="#EAF3FA" HeadersVisibility="Column"
                              ItemsSource="{Binding ListaFarmacisti}" SelectedItem="{Binding FarmacistCurent}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="45"/>
                            <DataGridTextColumn Header="Nume complet" Binding="{Binding Nume}" Width="150"/>
                            <DataGridTextColumn Header="E-mail cont" Binding="{Binding Email}" Width="*"/>
                            <DataGridTextColumn Header="Parolă" Binding="{Binding Parola}" Width="80"/>
                            <DataGridCheckBoxColumn Header="Admin" Binding="{Binding EsteAdmin}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</Window>